# 跑团故事机 - 环境变量
# 以下所有 Key 均为可选：可以在浏览器设置面板中输入，也可在此 .env 中配置

# DeepSeek API Key (获取: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# 可选: 指定模型 (默认 deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# 图片生成 API Key (可选，浏览器设置面板也可输入)
# OpenAI 图片 (获取: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key-here
# 或统一图片 Key
IMAGE_API_KEY=sk-your-image-api-key-here

# Python NLP / NetworkX 服务
NLP_SERVICE_URL=http://127.0.0.1:8001
# 可选：安装 requirements-model.txt 后设置 Transformers NER 模型名称
NLP_MODEL_NAME=
